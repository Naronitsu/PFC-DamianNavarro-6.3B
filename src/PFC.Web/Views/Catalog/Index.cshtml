@model List<PFC.Web.ViewModels.CatalogMenuRow>
@{
    ViewData["Title"] = "Catalog";
}

<h1>Menus</h1>

@if (ViewBag.IncludePending as bool? == true)
{
    <p class="text-muted">Including pending restaurants (dev).</p>
}
else
{
    <p class="text-muted">Showing ready/confirmed only. Use <strong>Toggle pending</strong> or <code>?includePending=true</code> for pending OCR menus.</p>
}

<p>
    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", new { includePending = !(ViewBag.IncludePending as bool? ?? false) })">
        Toggle pending
    </a>
</p>

@if (Model.Count == 0)
{
    <p>No menus to show yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Restaurant</th>
                <th>Menu</th>
                <th>Status</th>
                <th>Preview</th>
                <th>Translate</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td data-rid="@row.RestaurantId">@row.RestaurantName</td>
                <td data-mid="@row.MenuId">@row.MenuTitle</td>
                <td>@row.RestaurantStatus</td>
                <td style="max-width:320px;white-space:pre-wrap;font-size:0.85rem;">@(row.OcrText.Length > 400 ? row.OcrText.Substring(0, 400) + "…" : row.OcrText)</td>
                <td>
                    <textarea class="d-none ocr-full">@row.OcrText</textarea>
                    <div class="input-group input-group-sm">
                        <select class="form-select lang-select" style="max-width:110px">
                            <option value="fr">French</option>
                            <option value="de">German</option>
                            <option value="mt">Maltese</option>
                            <option value="it">Italian</option>
                            <option value="es">Spanish</option>
                        </select>
                        <button type="button" class="btn btn-primary tr-btn">Go</button>
                    </div>
                    <div class="small text-muted tr-out mt-1"></div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
<script>
document.querySelectorAll('.tr-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const cell = btn.closest('td');
        const text = cell.querySelector('.ocr-full').value;
        const lang = cell.querySelector('.lang-select').value;
        const out = cell.querySelector('.tr-out');
        const row = btn.closest('tr');
        const rid = row.cells[0].dataset.rid;
        const mid = row.cells[1].dataset.mid;
        out.textContent = '…';
        const res = await fetch('@Url.Action("Translate", "Catalog")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ restaurantId: rid, menuId: mid, text: text, targetLanguage: lang })
        });
        if (!res.ok) {
            out.textContent = 'failed';
            return;
        }
        const j = await res.json();
        out.textContent = j.translatedText || '';
    });
});
</script>
}
