@model List<PFC.Web.ViewModels.CatalogDishRow>
@{
    ViewData["Title"] = "Catalog";
    var includePending = ViewBag.IncludePending as bool? ?? false;
    var query = ViewBag.Query as string ?? "";
    var sort = ViewBag.Sort as string ?? "price_asc";
    var pendingMenus = ViewBag.PendingMenus as List<string> ?? new List<string>();
}

<section class="panel-card">
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Catalog</h1>
        @if (includePending)
        {
            <p class="text-muted mb-0">Including pending restaurants with structured items.</p>
        }
        else
        {
            <p class="text-muted mb-0">Showing ready/confirmed restaurants.</p>
        }
    </div>
</div>

<form method="get" class="row g-2 align-items-end mb-4">
    <input type="hidden" name="includePending" value="@(includePending ? "true" : "false")" />
    <div class="col-md-4">
        <label class="form-label" for="q">Search</label>
        <input type="search" class="form-control" id="q" name="q" value="@query" placeholder="dish or restaurant" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="sort">Sort by price</label>
        <select class="form-select" id="sort" name="sort">
            @if (sort == "price_desc")
            {
                <option value="price_asc">Low to high</option>
                <option value="price_desc" selected>High to low</option>
            }
            else
            {
                <option value="price_asc" selected>Low to high</option>
                <option value="price_desc">High to low</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-primary">Apply</button>
    </div>
    <div class="col-md-auto">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", new { q = query, sort, includePending = !includePending })">Toggle pending</a>
    </div>
</form>

@if (includePending && pendingMenus.Count > 0)
{
    <div class="alert alert-warning mb-4">
        <strong>@pendingMenus.Count pending menu(s)</strong> waiting for processor output.
        <ul class="mb-0 mt-2">
            @foreach (var p in pendingMenus.Take(6))
            {
                <li>@p</li>
            }
        </ul>
    </div>
}

@if (Model.Count == 0)
{
    <p class="mb-0">No dishes to show. Upload menus, run the processor, then search again.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Restaurant</th>
                <th>Menu</th>
                <th>Dish</th>
                <th>Price</th>
                <th>Translate</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td data-rid="@row.RestaurantId">@row.RestaurantName</td>
                <td data-mid="@row.MenuId">@row.MenuTitle</td>
                <td>@row.ItemName</td>
                <td>@row.Price.ToString("0.##") @row.Currency</td>
                <td>
                    <textarea class="d-none tr-source">@row.TranslateLine</textarea>
                    @if (row.CanTranslate)
                    {
                        <div class="input-group input-group-sm">
                            <select class="form-select lang-select" style="max-width:110px">
                                <option value="fr">French</option>
                                <option value="de">German</option>
                                <option value="mt">Maltese</option>
                                <option value="it">Italian</option>
                                <option value="es">Spanish</option>
                            </select>
                            <button type="button" class="btn btn-primary tr-btn">Go</button>
                        </div>
                        <div class="small text-muted tr-out mt-1"></div>
                    }
                    else
                    {
                        <span class="text-muted small">When ready</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
</section>

@section Scripts {
<script>
document.querySelectorAll('.tr-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const cell = btn.closest('td');
        const text = cell.querySelector('.tr-source').value;
        const lang = cell.querySelector('.lang-select').value;
        const out = cell.querySelector('.tr-out');
        const row = btn.closest('tr');
        const rid = row.cells[0].dataset.rid;
        const mid = row.cells[1].dataset.mid;
        out.textContent = '…';
        const res = await fetch('@Url.Action("Translate", "Catalog")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ restaurantId: rid, menuId: mid, text: text, targetLanguage: lang })
        });
        if (!res.ok) {
            out.textContent = 'failed';
            return;
        }
        const j = await res.json();
        out.textContent = j.translatedText || '';
    });
});
</script>
}
