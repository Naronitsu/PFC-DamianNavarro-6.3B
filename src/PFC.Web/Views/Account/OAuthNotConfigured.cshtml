@{
    ViewData["Title"] = "Sign in";
}

<section class="panel-card">
    <h1 class="h4 mb-3">Google sign-in is not configured</h1>
    <p class="text-muted mb-3">
        Set <code>Gcp:OAuthGoogleClientId</code> and <code>Gcp:OAuthClientSecretSecretId</code>,
        then grant this app access to read the secret version in Secret Manager.
    </p>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to home</a>
</section>
